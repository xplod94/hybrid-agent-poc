{
    "$schema": "https://opencode.ai/config.json",
    "agent": {
        "orchestrator": {
            "model": "local-llama.cpp/Ornith-1.5-35B-A3B-Q6_K",
            "prompt": "{file:./agents/orchestrator.md}",
            "mode": "primary",
            "permission": {
                "edit": "deny",
                "bash": "deny",
                "task": {
                    "*": "deny",
                    "worker": "allow",
                    "architect": "allow",
                    "debugger": "allow"
                }
            }
        },
        "architect": {
            "model": "bounteous-ai/claude-sonnet-4-6",
            "prompt": "{file:./agents/architect.md}",
            "mode": "subagent",
            "permission": {
                "edit": {
                    "*": "deny",
                    "PLAN.md": "allow",
                    "STATE.md": "allow",
                    "webfetch": "allow"
                },
                "bash": {
                    "python scripts/update_plan_state.py *": "allow",
                    "*": "deny"
                },
                "task": "deny"
            }
        },
        "debugger": {
            "model": "bounteous-ai/claude-sonnet-4-6",
            "prompt": "{file:./agents/debugger.md}",
            "mode": "subagent",
            "permission": {
                "edit": {
                    "*": "deny",
                    "PLAN.md": "allow",
                    "STATE.md": "allow"
                },
                "bash": "allow",
                "task": "deny"
            }
        },
        "worker": {
            "model": "local-llama.cpp/Ornith-1.5-35B-A3B-Q6_K",
            "prompt": "{file:./agents/worker.md}",
            "mode": "subagent",
            "permission": {
                "edit": "allow",
                "bash": "allow",
                "task": "deny"
            }
        }
    }
}